<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面图标前景：日历图案。

  * 大小：整体按中心缩放 0.78（原来几乎顶到画布边缘，缩小后留白更均匀）。
  * 配色：**保留原本的蓝＋橙配色**，只把对比度压下来一档——
    底色由高饱和亮蓝改为偏蓝紫，主体由纯白改为微冷的浅白，
    顶部条由刺眼的亮橙改为柔和一点的橙。
    对比度从约 5.7:1 降到约 4.3:1（相对亮度比），明显柔和但颜色不糊。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- pivotX/Y 取画布中心，这样缩放后图案仍然居中 -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.78"
        android:scaleY="0.78">

        <!-- 日历主体 -->
        <path
            android:fillColor="#EFF3FA"
            android:pathData="M30,32 h48 a4,4 0 0 1 4,4 v40 a4,4 0 0 1 -4,4 h-48 a4,4 0 0 1 -4,-4 v-40 a4,4 0 0 1 4,-4 z" />
        <!-- 顶部条 -->
        <path
            android:fillColor="#F58A2E"
            android:pathData="M26,32 h56 v10 h-56 z" />
        <!-- 挂环 -->
        <path
            android:fillColor="#EFF3FA"
            android:pathData="M38,26 h4 v10 h-4 z M66,26 h4 v10 h-4 z" />
        <!-- 网格点 -->
        <path
            android:fillColor="#4A6FC4"
            android:pathData="M36,50 h8 v8 h-8 z M50,50 h8 v8 h-8 z M64,50 h8 v8 h-8 z M36,64 h8 v8 h-8 z M50,64 h8 v8 h-8 z M64,64 h8 v8 h-8 z" />
    </group>
</vector>
