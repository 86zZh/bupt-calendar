<?xml version="1.0" encoding="utf-8"?>
<!--
  右上角「更多」图标（三个点）。

  比系统默认的三个点**更大、间距更开**，在深紫顶栏上更容易被注意到。
  用 ?attr/colorControlNormal 取色，所以会自动跟着顶栏主题变成白色。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M12,4.2 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0" />
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M12,12 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0" />
    <path
        android:fillColor="?attr/colorControlNormal"
        android:pathData="M12,19.8 m-2.6,0 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0" />
</vector>
