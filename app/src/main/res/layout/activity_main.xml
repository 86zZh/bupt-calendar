<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
      整体是「一个 WebView + 一个悬浮按钮」的结构：
      用户只做一件事 —— 在内置浏览器里登进教务、翻到课表页面，
      然后点右下角那个一直悬浮着的按钮。

      关于顶部：
      `topArea` 自带紫色背景，代码里会给它加等于「状态栏＋挖孔/灵动岛」高度的
      上内边距。因为内边距区域同样会被背景填充，所以**状态栏那一条也是紫色**，
      而里面的工具栏（含右上角三个点）则整体下移、不会被灵动岛压住。
    -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部整条：紫色背景会一直铺到屏幕最顶端 -->
        <LinearLayout
            android:id="@+id/topArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand_purple"
            android:orientation="vertical">

            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@android:color/transparent"
                app:menu="@menu/main_menu"
                app:theme="@style/ThemeOverlay.BuptCalendar.Toolbar"
                app:title="@string/app_name"
                app:titleTextColor="@color/on_brand_purple" />
        </LinearLayout>

        <!-- 入口选择 + 地址栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/url_bar_background"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCampus"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_campus"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconTint="@color/on_brand_purple"
                    app:chipBackgroundColor="@color/chip_background_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipWebVpn"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/source_webvpn"
                    android:textColor="@color/chip_text_color"
                    app:checkedIconTint="@color/on_brand_purple"
                    app:chipBackgroundColor="@color/chip_background_color"
                    app:chipStrokeColor="@color/chip_stroke_color"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>

            <EditText
                android:id="@+id/editUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="url"
                android:hint="@string/hint_url"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/url_bar_text"
                android:textColorHint="@color/url_bar_hint"
                android:textSize="13sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:max="100"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!--
      悬浮的导入按钮：全程存在，不随页面滚动消失。
      带文字标签，避免用户不知道那个圆按钮是干什么的。
      颜色与顶部条统一用品牌深紫。
    -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabImport"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="@string/fab_import"
        android:textColor="@color/on_brand_purple"
        app:backgroundTint="@color/brand_purple"
        app:icon="@android:drawable/ic_menu_my_calendar"
        app:iconTint="@color/on_brand_purple" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
